PORT=4000

DB_HOST=localhost
DB_PORT=3306
DB_USER=expense_app
DB_PASSWORD=devpass
DB_NAME=expense_tracker
DB_POOL_SIZE=10

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

FRONTEND_ORIGIN=http://localhost:5173

# "cookie" (httpOnly, preferred) or "header" (Authorization: Bearer)
AUTH_MODE=cookie

# On by default (src/server.js requires ./tracing unless this is exactly
# "false"). Only the staged teaching build in
# ../expense-app-stages/v1-metrics sets this to false — that stage has no
# otel-collector for spans to export to.
# ENABLE_TRACING=false

# Mounts /debug/* (failure-injection toggles for the teaching scenarios).
# Must stay unset/false outside an active teaching session; when unset,
# /debug/* isn't just access-denied, the routes are never registered at all.
# ENABLE_DEBUG_ROUTES=true

# Mounts /agent-remediation/restart, the RCA agent's only write action.
# Requires the container to have Docker socket access
# (observability/docker-compose.yml) to actually work — see that file's
# comment on the real security tradeoff that involves before enabling this
# outside a supervised session.
# ENABLE_AGENT_REMEDIATION=true
